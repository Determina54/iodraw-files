{"root":{"data":{"id":"djy3v9txl81s","created":1784013112857,"text":"Grammar","expandState":"expand"},"children":[{"data":{"id":"djy9hd942cxs","created":1784028949866,"text":"状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9hruzlkw0","created":1784028981664,"text":"定义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9hu23swsg","created":1784028986448,"text":"复合句中起状语作用的从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9irz0mpds","created":1784029060272,"text":"条件状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9vkots35s","created":1784030063152,"text":"含义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9vqx7cwsg","created":1784030076719,"text":"用于说明主句动作发生的条件的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9n2xyd7gg","created":1784029397609,"text":"引导词","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9n96qjrpc","created":1784029411200,"text":"if 如果; unless=if ... not除非 ; as long as只要","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9kemcgf7k","created":1784029187935,"text":"时态","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9kgw9woow","created":1784029192889,"text":"主将从现","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9psb9g2yo","created":1784029609561,"text":"主句用一般将来时，从句用一般现在时","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9ma9kf0u8","created":1784029335184,"text":"主情从现","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9qepidx4w","created":1784029658312,"text":"主句含情态动词，从句用一般现在时","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9kk4k0gsg","created":1784029199920,"text":"主祈从现","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9qfn3h2bk","created":1784029660343,"text":"主句是祈使句，从句用一般现在时","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9kopxc64g","created":1784029209920,"text":"真理永现（0条件句）","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9qgil0cg0","created":1784029662247,"text":"普遍真理、科学事实或习惯性动作，主句从句都用一般现在时","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9ksxkn4lc","created":1784029219089,"text":"虚拟条件句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9qh9znwu8","created":1784029663904,"text":"条件不符合客观事实，状语从句中用“主语+were/should do/were to do”，主句用“主语+should/would/could/might\"","layout":null,"expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"djy9isnqvqbk","created":1784029061767,"text":"原因状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9wbqlbgn4","created":1784030122032,"text":"含义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9wmbrd7uo","created":1784030145080,"text":"用于说明主句行为的原因的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9uruz35kw","created":1784030000397,"text":"引导词","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9uuc27ta8","created":1784030005784,"text":"because因为/as显然(双方已知.语气弱)/since显然/for/now that","layout":null,"expandState":"expand"},"children":[]}]}]},{"data":{"id":"djy9it0vh98g","created":1784029062561,"text":"时间状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9y3afkmps","created":1784030260369,"text":"含义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djy9yh88cbuo","created":1784030290711,"text":"表达主句事情或行为发生时间的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zvcw1a0w","created":1784030399831,"text":"when引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya1hydmrr4","created":1784030527384,"text":"意为\"当...的时候\"，可以表示某一时间点或时间段发生的事情，主句与从句描述内容可以同时发生或先后发生","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zvp2q7sw","created":1784030400568,"text":"as soon as引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya4dda9dds","created":1784030752494,"text":"意为\"一...就...\"，强调动作紧密相连","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zw0ke4g0","created":1784030401263,"text":"before/after引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya5yn6ayv4","created":1784030877169,"text":"before意为\"在之前\",after意为\"在...之后\"","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zw5biuww","created":1784030401551,"text":"while引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya67cu4mww","created":1784030896135,"text":"表示主句的行为在从句行为进行的时候发生，表示持续行为，\n从句用持续性动词或状态动词，且持续性动词多用进行时态","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zw9f7sow","created":1784030401799,"text":"until引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya8b41oagw","created":1784031061039,"text":"表示动作或状态一直持续到某一时刻，\"直到...为止\"\nnot .. until : 直到...才","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djy9zwfmicjk","created":1784030402174,"text":"since引导","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya9elsr11c","created":1784031147006,"text":"意为\"自从\"，主句多用完成时","layout":null,"expandState":"expand"},"children":[]}]}]},{"data":{"id":"djy9it85pr7k","created":1784029063001,"text":"地点状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya9q4leccg","created":1784031172088,"text":"含义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djya9u0f6wao","created":1784031180542,"text":"用于说明主句事情或行为发生地点的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djya9oojdbls","created":1784031168940,"text":"引导词","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyaa70dzh8g","created":1784031208839,"text":"where/wherever/anywhere","layout":null,"expandState":"expand"},"children":[]}]}]},{"data":{"id":"djy9itt5uvi8","created":1784029064271,"text":"目的状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyabftz6tc0","created":1784031306406,"text":"含义","expandState":"expand","layout":null},"children":[{"data":{"id":"djyabigkl05c","created":1784031312126,"text":"用于说明主句行为的目的的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djyabz9r7dvk","created":1784031348719,"text":"引导词","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyac6jkpips","created":1784031364550,"text":"so that/in order that/that/lest","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djyadgplofsw","created":1784031465047,"text":"从句一般含有表示可能性的词语 e.g. could/will/would/can","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djyaafyaj8cg","created":1784031228303,"text":"结果状语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyaf77q1w5c","created":1784031601103,"text":"含义","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyafa8x2sjk","created":1784031607706,"text":"用于表示由于某个行为导致的结果的状语从句","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"djyafk70nvgg","created":1784031629358,"text":"引导词","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyafmz5ohkw","created":1784031635413,"text":"so ..that/such .. that/","layout":null,"expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"djy97n13yrk0","created":1784028187508,"text":"定语从句","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyan8qz0xs0","created":1784032231357,"text":"含义"},"children":[{"data":{"id":"djyanct6kmww","created":1784032240198,"text":"复合句中起定语作用的从句"},"children":[]}]},{"data":{"id":"djyao579edj4","created":1784032301999,"text":"who引导"},"children":[{"data":{"id":"djyaoob9gm4g","created":1784032343600,"text":"句法作用"},"children":[{"data":{"id":"djyasrs8twqo","created":1784032664614,"text":"修饰先行词，who作为引导词在定语从句主体与先行词之间起连接作用，同时在定语从句中充当句子成分"},"children":[]}]},{"data":{"id":"djyavh754pa8","created":1784032876662,"text":"先行词指人，引导词用who"},"children":[]},{"data":{"id":"djyax65ff7k0","created":1784033009342,"text":"who在从句中充当宾语时，用宾格whom（口语who也可代替）"},"children":[]}]},{"data":{"id":"djyao5p94idc","created":1784032303087,"text":"that引导"},"children":[{"data":{"id":"djyayaovtfcw","created":1784033097590,"text":"可修饰人或物，在从句中可做主语或宾语（作宾语时可以省略）"},"children":[]}]},{"data":{"id":"djyao6fp51q8","created":1784032304686,"text":"which引导"},"children":[{"data":{"id":"djyazbqab75s","created":1784033178216,"text":"一般修饰物，从句中可做主宾"},"children":[]}]},{"data":{"id":"djyaor0vc2kg","created":1784032349502,"text":"引导词的省略"},"children":[{"data":{"id":"djyazssu0iyo","created":1784033215375,"text":"引导词在从句中作宾语可以省略，作主语不可省略\n正式文体不省略"},"children":[]}]}]},{"data":{"id":"djy97o7l54hs","created":1784028190077,"text":"构词法","layout":null,"expandState":"expand"},"children":[{"data":{"id":"djyb2idnfaww","created":1784033427782,"text":"合成法"},"children":[{"data":{"id":"djyb3984cv7k","created":1784033486221,"text":"两个及以上独立且语义不同的词合成构成新词"},"children":[]}]},{"data":{"id":"djyb2javclxc","created":1784033429790,"text":"派生法"},"children":[{"data":{"id":"djyb4rcmnzls","created":1784033604039,"text":"词根前加前缀/词根后加后缀"},"children":[]},{"data":{"id":"djyb57aj50qo","created":1784033638741,"text":"常见前缀"},"children":[{"data":{"id":"djyb793xv20w","created":1784033799424,"text":"dis-,im-,in-,un- 不\nen- 使动\ninter- 在..之间，相互","layout_left_offset":{"x":-105,"y":3}},"children":[]}]},{"data":{"id":"djyb586b0mps","created":1784033640662,"text":"常见后缀"},"children":[]}]},{"data":{"id":"djyb2lt3q6f4","created":1784033435246,"text":"转化法"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}