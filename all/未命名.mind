{"root":{"data":{"id":"djy3v9txl81s","created":1784013112857,"text":"Grammar"},"children":[{"data":{"id":"djy9hd942cxs","created":1784028949866,"text":"状语从句","layout":null},"children":[{"data":{"id":"djy9hruzlkw0","created":1784028981664,"text":"定义","layout":null},"children":[{"data":{"id":"djy9hu23swsg","created":1784028986448,"text":"复合句中起状语作用的从句","layout":null},"children":[]}]},{"data":{"id":"djy9irz0mpds","created":1784029060272,"text":"条件状语从句"},"children":[{"data":{"id":"djy9n2xyd7gg","created":1784029397609,"text":"引导词"},"children":[{"data":{"id":"djy9n96qjrpc","created":1784029411200,"text":"if 如果; unless=if ... not除非 ; as long as只要"},"children":[]}]},{"data":{"id":"djy9kemcgf7k","created":1784029187935,"text":"时态"},"children":[{"data":{"id":"djy9kgw9woow","created":1784029192889,"text":"主将从现"},"children":[{"data":{"id":"djy9psb9g2yo","created":1784029609561,"text":"主句用一般将来时，从句用一般现在时"},"children":[]}]},{"data":{"id":"djy9ma9kf0u8","created":1784029335184,"text":"主情从现"},"children":[{"data":{"id":"djy9qepidx4w","created":1784029658312,"text":"主句含情态动词，从句用一般现在时"},"children":[]}]},{"data":{"id":"djy9kk4k0gsg","created":1784029199920,"text":"主祈从现"},"children":[{"data":{"id":"djy9qfn3h2bk","created":1784029660343,"text":"主句是祈使句，从句用一般现在时"},"children":[]}]},{"data":{"id":"djy9kopxc64g","created":1784029209920,"text":"真理永现（0条件句）"},"children":[{"data":{"id":"djy9qgil0cg0","created":1784029662247,"text":"普遍真理、科学事实或习惯性动作，主句从句都用一般现在时"},"children":[]}]},{"data":{"id":"djy9ksxkn4lc","created":1784029219089,"text":"虚拟条件句"},"children":[{"data":{"id":"djy9qh9znwu8","created":1784029663904,"text":"条件不符合客观事实，状语从句中用“主语+were”"},"children":[]}]}]}]},{"data":{"id":"djy9isnqvqbk","created":1784029061767,"text":"原因状语从句"},"children":[]},{"data":{"id":"djy9it0vh98g","created":1784029062561,"text":"时间状语从句"},"children":[]},{"data":{"id":"djy9it85pr7k","created":1784029063001,"text":"地点状语从句"},"children":[]},{"data":{"id":"djy9itt5uvi8","created":1784029064271,"text":"分支主题"},"children":[]}]}