{"root":{"data":{"id":"dg5azhotu4w0","created":1770119477125,"text":"Grammar","priority":null},"children":[{"data":{"id":"dg5azpl9yk80","created":1770119494324,"text":"情态动词","layout":null},"children":[{"data":{"id":"dg6t3j1ssn40","created":1770272133477,"text":"含义","layout":null},"children":[{"data":{"id":"dg6t3toq6cg0","created":1770272156632,"text":"表示说话人对有关行为或事物的态度或看法","layout":null},"children":[]}]},{"data":{"id":"dg6t3jg4ytc0","created":1770272134344,"text":"情态","layout":null},"children":[{"data":{"id":"dg6t42q9jkw0","created":1770272176316,"text":"命令，允诺，义务，可能，需要等","layout":null},"children":[]}]},{"data":{"id":"dg6t3k03diw0","created":1770272135551,"text":"特点","layout":null},"children":[{"data":{"id":"dg6t4tvi7h40","created":1770272235406,"text":"一般无人称和数的变化","layout":null},"children":[]},{"data":{"id":"dg6t4udsqjs0","created":1770272236512,"text":"后面接的动词用原形","layout":null},"children":[]},{"data":{"id":"dg6t4ugcsgw0","created":1770272236666,"text":"否定式：在情态动词后接not","layout":null},"children":[]}]},{"data":{"id":"dg6t3kjimqg0","created":1770272136726,"text":"常见情态动词（组）","layout":null},"children":[{"data":{"id":"dg6t5o5cqnc0","created":1770272301305,"text":"should","layout":null},"children":[{"data":{"id":"dg6t5wu7ei80","created":1770272320222,"text":"表建议或劝告，意为“应当”","layout":null},"children":[]},{"data":{"id":"dg6t5wvty200","created":1770272320320,"text":"可用于肯定句，否定句，疑问句","layout":null},"children":[]},{"data":{"id":"dg6t68owmso0","created":1770272346023,"text":"否定式 shouldn`t表示\"不应\"的意思","layout":null},"children":[]}]},{"data":{"id":"dg6t5ozm5eo0","created":1770272303134,"text":"must","layout":null},"children":[{"data":{"id":"dg6tcj9j81c0","created":1770272839223,"text":"意为“必须”","layout":null},"children":[]},{"data":{"id":"dg6tcm6zdjk0","created":1770272845599,"text":"可用于肯定句，否定句与疑问句","layout":null},"children":[]},{"data":{"id":"dg6tcse7elc0","created":1770272859096,"text":"否定形式mustn`t表示\"不应该\"或\"禁止\"的意思","layout":null},"children":[]}]},{"data":{"id":"dg6t5p5z3jk0","created":1770272303519,"text":"can","layout":null},"children":[{"data":{"id":"dg6tdjg2a800","created":1770272917982,"text":"意为“请求允许”或“给予许可”    ","layout":null},"children":[]},{"data":{"id":"dg6tg0qg63k0","created":1770273112343,"text":"可用于肯定句，否定句，疑问句","layout":null},"children":[]},{"data":{"id":"dg6tggfoccw0","created":1770273146520,"text":"否定形式can`t表示“不能，不可以”，语气弱于mustn`t","layout":null},"children":[]}]},{"data":{"id":"dg6t5p9f5yw0","created":1770272303727,"text":"need","layout":null},"children":[{"data":{"id":"dg6tkzqn3qo0","created":1770273501999,"text":"意为“需要”","layout":null},"children":[]},{"data":{"id":"dg6tl63e4qo0","created":1770273515831,"text":"可用于肯定句，否定句，疑问句","layout":null},"children":[]},{"data":{"id":"dg6tle9s8n40","created":1770273533631,"text":"否定形式 needn`t意为“不需要，不必要”","layout":null},"children":[]},{"data":{"id":"dg6tmzrfhs80","created":1770273658775,"text":"也可以作行为动词，意为“需要”，常用于 need to do sth","layout":null},"children":[]}]},{"data":{"id":"dg6tmxmyhxk0","created":1770273654151,"text":"must,can,need的一般疑问句构成及其回答","layout":null},"children":[{"data":{"id":"dg6tnrc4fa80","created":1770273718799,"text":"Must/Can/Need + 主语 + 动词原形 + 其他？","layout":null},"children":[]},{"data":{"id":"dg6toa4i5xc0","created":1770273759697,"text":"Yes, 主语 + must/can/need.","layout":null},"children":[]},{"data":{"id":"dg6toq7192g0","created":1770273794679,"text":"No, 主语 + must/can/need的否定形式.","layout":null},"children":[]}]},{"data":{"id":"dg6tnpuo22g0","created":1770273715567,"text":"have to","layout":null},"children":[{"data":{"id":"dg6tpb51aa80","created":1770273840271,"text":"意为“必须”","layout":null},"children":[]},{"data":{"id":"dg6tpf6birs0","created":1770273849055,"text":"与must相比较","layout":null},"children":[{"data":{"id":"dg6tpng9lrk0","created":1770273867071,"text":"must侧重于说话者主观看法，认为有必要或有义务去做某事","layout":null},"children":[]},{"data":{"id":"dg6tpxkmuls0","created":1770273889103,"text":"have to则侧重于客观需要，含有“不得不，被迫”之意","layout":null},"children":[]},{"data":{"id":"dg6tqdkfb9c0","created":1770273923919,"text":"have to 否定式 don`t have to = needn`t","layout":null},"children":[]}]}]},{"data":{"id":"dg6tkyecp3s0","created":1770273499079,"text":"had better","layout":null},"children":[{"data":{"id":"dg6trgkusb40","created":1770274008839,"text":"表示劝告或建议，意为“最好”","layout":null},"children":[]},{"data":{"id":"dg6trl5kcv40","created":1770274018799,"text":"一般不用于疑问句，但可用于肯定句，否定句中","layout":null},"children":[]},{"data":{"id":"dg6trsyq03s0","created":1770274035799,"text":"否定形式为had better not","layout":null},"children":[]}]},{"data":{"id":"dg6um7bwhw80","created":1770276417996,"text":"表猜测类","expandState":"expand","layout":null},"children":[{"data":{"id":"dg6ts483i880","created":1770274060311,"text":"may/might","layout":null},"children":[{"data":{"id":"dg6ts6rs7kw0","created":1770274065855,"text":"表示可能发生某事或某人可能做某事","layout":null},"children":[]},{"data":{"id":"dg6tscnv9hs0","created":1770274078679,"text":"两词无太大差别，形式上 might是may的过去式\n但在表示现在或将来的可能情况时，might表示的可能性比may表示的可能性稍小一些","layout":null},"children":[]}]},{"data":{"id":"dg6umhclwjc0","created":1770276439807,"text":"can/could","layout":null},"children":[{"data":{"id":"dg6umkkdpi80","created":1770276446807,"text":"表示“能够，可以”之外，还能表示对现在或未来的推测，意为“会，可能”","layout":null},"children":[]},{"data":{"id":"dg6umxo75r40","created":1770276475336,"text":"can表示推测时，往往用于否定句与疑问句","expandState":"expand","layout":null},"children":[{"data":{"id":"dg6un7k7xww0","created":1770276496863,"text":"用于疑问句时，can比could表示的可能性要大","layout":null},"children":[]},{"data":{"id":"dg6unelrevs0","created":1770276512194,"text":"用于否定句时can`t表示不可能","layout":null},"children":[]}]},{"data":{"id":"dg6unug2r1c0","created":1770276546679,"text":"could可用于肯定句，否定句与疑问句","layout":null},"children":[]}]},{"data":{"id":"dg6uo5hxrjk0","created":1770276570736,"text":"must","layout":null},"children":[{"data":{"id":"dg6uo8wzh6o0","created":1770276578176,"text":"意为“一定，肯定”，语气强烈，表示非常肯定，通常只用于肯定句中","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dgrc4px63q80","created":1772357027021,"text":"占位符"},"children":[]},{"data":{"id":"dg5azzkmn880","created":1770119516053,"text":"被动语态","layout":null},"children":[{"data":{"id":"dg5b39ydxwg0","created":1770119773745,"text":"定义","layout":null},"children":[{"data":{"id":"dg5b3pvsl8o0","created":1770119808417,"text":"动词的一种形式，用以说明主语与谓语动词之间的关系，其中主语是动作的承受者。","progress":null,"layout":null},"children":[]}]},{"data":{"id":"dg5blxk68940","created":1770121235683,"text":"使用被动语态的常见场景","layout":null},"children":[{"data":{"id":"dg5bm7ibz400","created":1770121257340,"text":"不知道或无需指出动作执行者","layout":null,"font-size":32},"children":[]},{"data":{"id":"dg5bm9z3cdk0","created":1770121262707,"text":"强调动作承受者","layout":null},"children":[]},{"data":{"id":"dg5bma16nqw0","created":1770121262833,"text":"客观描述科学事实、通用规则等","layout":null},"children":[]}]},{"data":{"id":"dg5b3bb830g0","created":1770119776698,"text":"一般句式（被动语态所有时态\n变化都体现在be动词上）","layout":null},"children":[{"data":{"id":"dg5b5gl6lig0","created":1770119944913,"text":"肯定句","layout":null},"children":[{"data":{"id":"dg5b7ef8aao0","created":1770120096927,"text":"主语+be动词+动词过去分词(+by+动作执行者)","layout":null},"children":[]}]},{"data":{"id":"dg5b5hdmq400","created":1770119946633,"text":"否定句","layout":null},"children":[{"data":{"id":"dg5b7f9tyt40","created":1770120098778,"text":"主语+be动词+not+动词过去分词(+by+动作执行者)","layout":null},"children":[]}]},{"data":{"id":"dg5b5hygpeo0","created":1770119947892,"text":"一般疑问句","layout":null},"children":[{"data":{"id":"dg5b7fkll3c0","created":1770120099429,"text":"Be动词+主语+动词过去分词(+by+动作执行者)","layout":null},"children":[]}]},{"data":{"id":"dg5b5ih7r680","created":1770119949026,"text":"特殊疑问句","layout":null},"children":[{"data":{"id":"dg5b7frpdrs0","created":1770120099858,"text":"特殊疑问词+be动词+主语+动词过去分词(+by+动作执行者)","layout":null},"children":[]}]}]},{"data":{"id":"dg5b3bj1uhc0","created":1770119777171,"text":"be动词变化","layout":null},"children":[{"data":{"id":"dg5babjux1c0","created":1770120325769,"text":"一般现在时","layout":null},"children":[{"data":{"id":"dg5bisec1zc0","created":1770120989354,"text":"be -> am/is/are","layout":null},"children":[]}]},{"data":{"id":"dg5babyednc0","created":1770120326649,"text":"一般过去时","layout":null},"children":[{"data":{"id":"dg5bisuqnz40","created":1770120990346,"text":"be -> was/were","layout":null},"children":[]}]},{"data":{"id":"dg5badabnow0","created":1770120329546,"text":"一般将来时","layout":null},"children":[{"data":{"id":"dg5bit65ihs0","created":1770120991036,"text":"be -> will be","layout":null},"children":[]}]}]},{"data":{"id":"dg5bmzbgjpk0","created":1770121317874,"text":"重要注意事项","layout":null},"children":[{"data":{"id":"dg5bn727y2w0","created":1770121334730,"text":"不及物动词（如 happen, die, rise）没有被动语态","layout":null},"children":[]},{"data":{"id":"dg5bn7j5mb40","created":1770121335754,"text":"当谓语部分是“使役动词/感官类系动词+省略to的不定式做宾补”时，省略的to要还原","layout":null},"children":[]},{"data":{"id":"dg5breuyuq00","created":1770121665162,"text":"有些动词的主动形式表示被动含义（如 sell, feel, write）","layout":null},"children":[]}]}]},{"data":{"id":"dg5aztehrl40","created":1770119502621,"text":"宾语从句","layout":null},"children":[{"data":{"id":"dg5b1xsrdeo0","created":1770119668919,"text":"意义","layout":null},"children":[{"data":{"id":"dg6upg1z3so0","created":1770276672079,"text":"放在动词后面做宾语的一个完整句子","layout":null},"children":[]}]},{"data":{"id":"dg5b1ytj5e00","created":1770119671143,"text":"分类","layout":null},"children":[{"data":{"id":"dg6upv33axk0","created":1770276704799,"text":"that引导的宾语从句","layout":null},"children":[{"data":{"id":"dg6uqk4sd4w0","created":1770276759321,"text":"当谓语动词表示肯定的概念，如“希望”“相信”\n“知道”“说”时，其后面的句子一般用that引导","layout":null},"children":[]},{"data":{"id":"dg6urlgm5ag0","created":1770276840577,"text":"that无词汇意义，只具有语法功能，多数情况可以省略","layout":null},"children":[]},{"data":{"id":"dg6uruych2w0","created":1770276861240,"text":"并非所有的动词后面都可接that引导的宾语从句，\n常见接that的动词有believe,expect,explain等","layout":null},"children":[]}]},{"data":{"id":"dg6upvgck740","created":1770276705600,"text":"whether/if引导的宾语从句","layout":null},"children":[{"data":{"id":"dg6usi5t0ao0","created":1770276911757,"text":"表达不确定的概念用whether/if\n引导宾语从句，不能用that","layout":null},"children":[]},{"data":{"id":"dg6usmy01540","created":1770276922169,"text":"宾语从句中无\"or not\"的情况下，两个词都可以用\n如果从句中有\"or not\"，一般选择whether，构成\n\"whether ... or not ...\"结构","layout":null},"children":[]}]},{"data":{"id":"dg6upvo5bag0","created":1770276706072,"text":"疑问词引导的宾语从句","layout":null},"children":[{"data":{"id":"dg6uua5kti80","created":1770277051057,"text":"表达需要疑问词含义的时候用疑问词引导的从句，如“什么时候出发”","layout":null},"children":[]},{"data":{"id":"dg6uuo1xfps0","created":1770277081312,"text":"疑问词引导的宾语从句时，应使用 主+谓+宾的陈述语序","layout":null},"children":[]}]}]},{"data":{"id":"dg6uvmfk3c80","created":1770277156146,"text":"时态","layout":null},"children":[{"data":{"id":"dg6uvxi558o0","created":1770277180247,"text":"当主句是现在时态时，从句可以根据实际情况选择不同时态","layout":null},"children":[]},{"data":{"id":"dg6uw6x4mpc0","created":1770277200744,"text":"当主句是过去时态时，从句一般使用相应的过去时态","layout":null},"children":[]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}